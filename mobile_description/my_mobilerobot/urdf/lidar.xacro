<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.04" />
    <xacro:property name="lidar_length" value="0.03" />

    <link name="lidar_link">
        <visual>
            <geometry>
                 <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}" />
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.1" r="${lidar_radius}" h="${lidar_length}"
                           o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <!-- Vùng hoạt động lidar (vòng đỏ bán trong suốt hiển thị vùng quét 5m) -->
    <xacro:property name="lidar_zone_radius" value="5.0" />
    <xacro:property name="lidar_zone_thickness" value="0.002" />

    <material name="red_transparent">
        <color rgba="1.0 0.0 0.0 0.15" />
    </material>

    <link name="lidar_zone_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_zone_radius}" length="${lidar_zone_thickness}" />
            </geometry>
            <material name="red_transparent" />
        </visual>
        <!-- Inertial rất nhỏ (bắt buộc cho Gazebo) -->
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7" />
        </inertial>
    </link>

    <joint name="lidar_zone_joint" type="fixed">
        <parent link="lidar_link" />
        <child link="lidar_zone_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- Màu đỏ bán trong suốt cho Gazebo (URDF material chỉ ảnh hưởng RViz) -->
    <gazebo reference="lidar_zone_link">
        <visual>
            <material>
                <ambient>1.0 0.0 0.0 0.15</ambient>
                <diffuse>1.0 0.0 0.0 0.15</diffuse>
                <specular>0.1 0.1 0.1 1.0</specular>
            </material>
        </visual>
    </gazebo>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />
    </joint>

    <!-- GAZEMBO SENSOR PLUGIN CHO LIDAR 2D -->
    <gazebo reference="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>5.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <always_on>true</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>