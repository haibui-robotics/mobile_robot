<launch>
  <!-- [SỬA 2026-11-02] Thêm các tham số cấu hình cho chế độ mô phỏng -->
  <arg name="launch_rviz" default="true"/>
  <arg name="use_sim_time" default="true"/>

  <!-- Include gazebo.launch.xml: đã bao gồm Gazebo, robot_state_publisher, ros_gz_bridge, controller.launch.xml và rviz2 -->
  <include file="$(find-pkg-share my_mobilerobot)/launch/gazebo.launch.xml">
    <arg name="launch_rviz" value="$(var launch_rviz)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- [SỬA 2026-11-02] Khởi chạy node simple_controller để tính toán Odometry (/mobile_controller/odom).
       Đặt publish_tf:=false để bộ lọc EKF bên dưới phát cây TF (odom -> base_footprint) đã dung hợp với IMU. -->
  <node pkg="mobile_controller" exec="simple_controller" name="simple_controller" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="publish_tf" value="false"/>
  </node>

  <!-- [THÊM 2026-11-02] Khởi chạy bộ lọc EKF kết hợp Odometry bánh xe và IMU trong Gazebo -->
  <include file="$(find-pkg-share mobile_localization)/launch/local_localization.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- [SỬA 2026-11-02] Tạm đóng controller.launch.xml vì bên trong gazebo.launch.xml (dòng 40) đã include rồi -->
  <!-- <include file="$(find-pkg-share mobile_controller)/launch/controller.launch.xml">
    <arg name="use_simple_controller" value="False"/>
    <arg name="use_python" value="False"/>
  </include> -->

  <!-- Include joystick_teleop.launch.py với launch argument use_sim_time=True -->
  <!-- <include file="$(find-pkg-share my_mobilerobot)/launch/joystick_teleop.launch.xml">
    <arg name="use_sim_time" value="True"/>
  </include> -->
</launch>