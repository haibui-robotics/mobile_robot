<launch>
  <arg name="serial_port" default="/dev/ttyUSB0"/>

  <!-- [NOTE] Sua package: my_mobilerobot_description -> my_mobilerobot, va truyen use_gazebo:=false, serial_port -->
  <let name="robot_description" 
       value="$(command 'xacro $(find-pkg-share my_mobilerobot)/urdf/my_robot.urdf.xacro use_gazebo:=false serial_port:=$(var serial_port)')" />

  <!-- Node robot_state_publisher -->
  <node pkg="robot_state_publisher" 
        exec="robot_state_publisher" 
        name="robot_state_publisher">
    <param name="robot_description" value="$(var robot_description)" />
  </node>

  <!-- Node controller_manager (ros2_control_node) -->
  <!-- [NOTE] Sua controllers.yaml -> controller.yaml de khop voi file config hien tai -->
  <!-- [SỬA 2026-11-02] Trên ROS 2 Jazzy, controller_manager tự động đọc URDF qua topic /robot_description
       từ robot_state_publisher. Không truyền trực tiếp param robot_description vào đây để tránh tạo file
       launch_params tạm thời cỡ lớn làm chậm/treo quá trình nạp spawner (joint_state_broadcaster). -->
  <node pkg="controller_manager" 
        exec="ros2_control_node" 
        name="controller_manager">
    <!-- <param name="robot_description" value="$(var robot_description)" /> -->
    <param name="use_sim_time" value="false" />
    <param from="$(find-pkg-share mobile_controller)/config/controller.yaml" />
  </node>
</launch>